# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJh...
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxx.supabase.co:5432/postgres

# Cloudflare R2
CF_ACCOUNT_ID=your_account_id
CF_R2_BUCKET_NAME=synapse-media
CF_R2_ACCESS_KEY_ID=your_r2_access_key
CF_R2_SECRET_ACCESS_KEY=your_r2_secret_key
CF_R2_PUBLIC_URL=https://pub-xxx.r2.dev

# Auth
JWT_SECRET_KEY=generate-a-long-random-string-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com
